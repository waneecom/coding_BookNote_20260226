# Supabase 환경변수 설정 예시
# .env.local 파일을 만들고 아래 내용을 채워주세요
# .env.local 은 .gitignore에 의해 GitHub에 올라가지 않습니다

REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# 서버 전용: 브라우저에 노출되면 안 됩니다.
# 로컬 개발에서는 npm start가 scripts/spell-api-dev.js를 함께 실행하면서 이 값을 읽습니다.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_SPELL_MODEL=gemini-3.5-flash
